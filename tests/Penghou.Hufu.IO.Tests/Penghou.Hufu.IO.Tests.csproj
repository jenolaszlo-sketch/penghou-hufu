<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UsePenghouSource Condition="'$(UsePenghouSource)' == ''">false</UsePenghouSource>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <ProjectReference Include="../../src/Penghou.Hufu.IO/Penghou.Hufu.IO.csproj" AdditionalProperties="UsePenghouSource=$(UsePenghouSource)" />
    <ProjectReference Include="../../../Penghou/src/Penghou.IO.Abstractions/Penghou.IO.Abstractions.csproj" Condition="'$(UsePenghouSource)' == 'true'" />
    <ProjectReference Include="../../../Penghou/src/Penghou.IO.Protocols/Penghou.IO.Protocols.csproj" Condition="'$(UsePenghouSource)' == 'true'" />
    <ProjectReference Include="../../../Penghou/src/Penghou.IO.Local/Penghou.IO.Local.csproj" Condition="'$(UsePenghouSource)' == 'true'" />
    <PackageReference Include="Penghou.IO.Abstractions" Version="[0.1.0-preview.1]" Condition="'$(UsePenghouSource)' != 'true'" />
    <PackageReference Include="Penghou.IO.Protocols" Version="[0.1.0-preview.1]" Condition="'$(UsePenghouSource)' != 'true'" />
    <PackageReference Include="Penghou.IO.Local" Version="[0.1.0-preview.1]" Condition="'$(UsePenghouSource)' != 'true'" />
  </ItemGroup>
</Project>
