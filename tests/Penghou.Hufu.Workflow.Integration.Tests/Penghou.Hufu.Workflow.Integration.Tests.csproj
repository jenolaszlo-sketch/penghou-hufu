<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Penghou.Zhinu" Version="[0.2.0-preview.1]" />
    <PackageReference Include="Penghou.Zhinu.Sqlite" Version="[0.2.0-preview.1]" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseHufuWorkflowPackage)' != 'true'">
    <ProjectReference Include="../../src/Penghou.Hufu.Workflow/Penghou.Hufu.Workflow.csproj" />
  </ItemGroup>
  <Target Name="RequireHufuWorkflowPackageVersion" BeforeTargets="Restore"
          Condition="'$(UseHufuWorkflowPackage)' == 'true' and '$(HufuWorkflowPackageVersion)' == ''">
    <Error Text="Set HufuWorkflowPackageVersion to the exact locally packed candidate version." />
  </Target>
  <ItemGroup Condition="'$(UseHufuWorkflowPackage)' == 'true'">
    <PackageReference Include="Penghou.Hufu.Workflow" Version="[$(HufuWorkflowPackageVersion)]" />
  </ItemGroup>
</Project>
